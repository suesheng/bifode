---
import MainLayout from '../layouts/MainLayout.astro';
import { Content } from '../components/beitragsordnung.md';
---

<MainLayout title="Beitragsordnung" description="Beitragsordnung von BiFoDe e.V. — Mitgliedschaft beitragsfrei.">
  <div class="container vdoc-page">
    <p class="vdoc-badge">Entwurf zur Beschlussfassung durch die Mitgliederversammlung</p>
    <article class="vdoc" lang="de">
      <Content />
    </article>
    <p class="vdoc-footer">
      Fragen: <a href="mailto:info@bifode.org">info@bifode.org</a> · <a href="/satzung">Geltende Satzung</a> · <a href="/mitglied-werden">Mitglied werden</a>
    </p>
  </div>
</MainLayout>

<style>
  .vdoc-page { max-width: 820px; margin: 0 auto; padding: 2rem 1rem 3rem; }
  .vdoc-badge { display: inline-block; margin: 0 0 1.25rem; padding: 0.35rem 0.75rem; border-radius: 999px; background: #fff7ed; color: #9a3412; font-size: 0.85rem; font-weight: 600; }
  .vdoc :global(h1) { font-size: 1.75rem; line-height: 1.25; margin: 0 0 1rem; }
  .vdoc :global(h2) { font-size: 1.2rem; margin: 2rem 0 0.75rem; }
  .vdoc :global(p), .vdoc :global(li) { color: #334155; line-height: 1.65; }
  .vdoc :global(table) { width: 100%; border-collapse: collapse; margin: 1rem 0; font-size: 0.92rem; display: block; overflow-x: auto; }
  .vdoc :global(th), .vdoc :global(td) { border: 1px solid #e2e8f0; padding: 0.5rem 0.6rem; text-align: left; vertical-align: top; }
  .vdoc :global(th) { background: #f8fafc; }
  .vdoc-footer { margin-top: 2rem; padding-top: 1.25rem; border-top: 1px solid #e2e8f0; font-size: 0.9rem; color: #64748b; }
  .vdoc-page a { color: #163b63; }
</style>
