---
/**
 * Mitgliedschaft — landing for new Verein members (no tracking yet).
 */
import MainLayout from '../layouts/MainLayout.astro';
import { MEINVEREIN_ANTRAG_URL, MOODLE_INFO_PATH, ULPAN_LANDING_PATH } from '../lib/communityLinks';

const meinVereinAntragUrl = MEINVEREIN_ANTRAG_URL;

const pageTitle = 'Mitglied werden | BiFoDe e.V.';
const pageDescription =
  'Mitgliedschaft bei BiFoDe e.V. — beitragsfrei. Mitglieder unterstützen die Vereinsarbeit und erhalten ermäßigte Teilnahmeentgelte für die Bildungsprojekte des Vereins.';

const ctaApply = 'Kostenlose Mitgliedschaft beantragen';


const vereinServices = [
  {
    title: 'Ulpan vor Ort & online',
    text: 'Hebräisch lernen in Präsenz- und Online-Formaten — offen für alle, für Mitglieder zum ermäßigten Teilnahmeentgelt. Kosten und Zahlungsweise auf der Projektseite Ulpan Ivrit.'
  },
  {
    title: 'Lernmaterialien & Moodle',
    text: 'Zugang zu Übungen, Links, Empfehlungen und der Moodle-Lernplattform für Mitglieder — mit Kursmaterialien zu Ulpan Ivrit.'
  },
  {
    title: 'Gemeinsame Treffen',
    text: 'Community-Runden und Begegnungen — inklusive Bewirtung bei ausgewählten Formaten.'
  },
  {
    title: 'Vereinsmaterialien',
    text: 'Ausgewählte Vereinsmaterialien, sofern verfügbar und passend zum jeweiligen Angebot.'
  },
  {
    title: 'Weitere Bildungsformate',
    text: 'Workshops, Webinare, Israel-Community-Formate und weitere Projekte von BiFoDe e.V.'
  },
  {
    title: 'Netzwerk & Mitgestaltung',
    text: 'Austausch, frühe Informationen zu neuen Kursen und die Möglichkeit, Projekte mitzuprägen.'
  }
];

const steps = [
  {
    title: 'Aufnahme beantragen',
    text: 'Online-Formular ausfüllen — die Mitgliedschaft ist beitragsfrei, ein Aufnahmebeitrag wird nicht erhoben.'
  },
  {
    title: 'Aufnahme & Zugang',
    text: 'Nach Prüfung entscheidet der Vorstand über die Aufnahme. Die Mitgliedschaft beginnt mit der Bestätigung per E-Mail.'
  },
  {
    title: 'Angebote nutzen',
    text: 'Ulpan, Moodle, Materialien, Treffen und weitere Formate — je nach Programm und Kapazität.'
  }
];

const webPageJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: pageTitle,
  url: 'https://www.bifode.org/mitglied-werden',
  description: pageDescription,
  inLanguage: 'de-DE',
  isPartOf: { '@type': 'WebSite', name: 'BiFoDe e.V.', url: 'https://www.bifode.org/' }
});
---

<MainLayout title={pageTitle} description={pageDescription} titleSuffix={false} mainClass="mw-main">
  <script type="application/ld+json" set:html={webPageJsonLd} />

  <div class="mw-page" data-landing="mitglied-werden">
    <section class="mw-hero" aria-labelledby="mw-hero-title">
      <div class="mw-hero-visual" aria-hidden="true"></div>
      <div class="container mw-hero-inner">
        <p class="mw-eyebrow">BiFoDe e.V. · Bildungsforum für Demokratie und Vielfalt NRW</p>
        <h1 id="mw-hero-title">Mitglied werden</h1>
        <p class="mw-hero-sub">Gemeinsam Bildung stärken — demokratisch, vielfältig und mit klarem gesellschaftlichem Auftrag.</p>
        <div class="mw-antrag mw-antrag-hero" id="anmeldung">
          <p class="mw-antrag-title">Die Mitgliedschaft bei BiFoDe e.V. ist beitragsfrei.</p>
          <p class="mw-antrag-text">
            Mit Ihrer Mitgliedschaft unterstützen Sie die gemeinnützige Bildungs-, Kultur- und Community-Arbeit von BiFoDe e.V. und erhalten ermäßigte Teilnahmeentgelte für unsere Kurse. Kein Aufnahmebeitrag · Austritt jederzeit mit einer Frist von einem Monat zum Monatsende.
          </p>
          <p class="mw-antrag-text">
            Füllen Sie den digitalen Mitgliedsantrag aus. Nach Eingang wird Ihr Antrag vom Vorstand geprüft. Für einzelne Bildungsangebote, Kurse oder Veranstaltungen können unabhängig von der Mitgliedschaft gesonderte Teilnahmeentgelte anfallen; die Bedingungen werden vor der Anmeldung mitgeteilt.
          </p>
          <a href={meinVereinAntragUrl} class="mw-btn mw-btn-primary mw-btn-antrag" target="_blank" rel="noopener noreferrer">{ctaApply}</a>
          <p class="mw-antrag-note">
            Das Antragsformular wird sicher über WISO MeinVerein geöffnet. Fragen?
            <a href="mailto:info@bifode.org?subject=Mitgliedschaft%20BiFoDe%20e.V.">info@bifode.org</a>
          </p>
        </div>
      </div>
    </section>

    <section class="mw-section" id="leistungen" aria-labelledby="mw-services-title">
      <div class="container">
        <h2 id="mw-services-title">Was die Mitgliedschaft ermöglicht</h2>
        <p class="mw-lead">
          Unsere Bildungsangebote stehen allen Interessierten offen. Als Mitglied unterstützen Sie die Vereinsarbeit, bleiben informiert und nehmen zu ermäßigten Teilnahmeentgelten teil (siehe <a href="/entgeltordnung">Entgeltordnung</a>).
        </p>
        <div class="card-grid">
          {vereinServices.map((item) => (
            <article class="card feature-card">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))}
        </div>
        <p class="mw-note">
          Die Teilnahme an konkreten Terminen erfolgt je nach Verfügbarkeit, Projektphase und Kapazität. Neue Mitglieder werden in der Regel als außerordentliche Mitglieder (ohne Stimmrecht in der Mitgliederversammlung) aufgenommen; über eine ordentliche Mitgliedschaft mit Stimmrecht entscheidet der Vorstand auf Antrag. Grundlage sind die <a href="/satzung">Satzung</a> und die <a href="/beitragsordnung">Beitragsordnung</a>.
        </p>
      </div>
    </section>

    <section class="mw-section mw-section-alt" id="ablauf" aria-labelledby="mw-steps-title">
      <div class="container">
        <div class="mw-split">
          <div class="mw-split-col">
            <h2 id="mw-steps-title">So funktioniert die Aufnahme</h2>
            <ol class="mw-steps">
              {steps.map((step, i) => (
                <li>
                  <span class="mw-step-num" aria-hidden="true">{i + 1}</span>
                  <div>
                    <h3>{step.title}</h3>
                    <p>{step.text}</p>
                  </div>
                </li>
              ))}
            </ol>
          </div>
          <div class="mw-split-col" id="zielgruppe" aria-labelledby="mw-who-title">
            <h2 id="mw-who-title">Wer kann Mitglied werden?</h2>
            <p class="mw-lead mw-lead-tight">
              Natürliche Personen, die unsere Bildungs- und Präventionsarbeit unterstützen möchten — in NRW, deutschlandweit oder im DACH-Raum, sofern eine Mitgliedschaft nach Satzung möglich ist.
            </p>
            <ul class="mw-list">
              <li>Engagierte für demokratische Bildung und gesellschaftlichen Zusammenhalt</li>
              <li>Interessierte an Israel Community, Hebräisch und verknüpften Bildungsformaten</li>
              <li>Partner, Fachkräfte und Ehrenamtliche, die den Verein langfristig stärken möchten</li>
              <li>Fördernde, die BiFoDe e.V. finanziell und ideell unterstützen wollen</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="mw-section mw-section-alt mw-form-section" aria-label="Steuerlicher Hinweis">
      <div class="container mw-form-container">
        <div class="mw-form-stack">
        <div class="mw-tax-note">
          <h3>Steuerlicher Hinweis</h3>
          <p>
            Die Mitgliedschaft ist beitragsfrei. Spenden an BiFoDe e.V. können unter den gesetzlichen Voraussetzungen steuerlich berücksichtigt werden; wir stellen hierfür Zuwendungsbestätigungen aus. Teilnahmeentgelte für Kurse sind keine Spenden und werden nicht bescheinigt.
          </p>
          <p class="mw-small">Diese Angabe ersetzt keine steuerliche Beratung.</p>
        </div>
        </div>
      </div>
    </section>

    <section class="mw-section mw-final" aria-labelledby="mw-final-title">
      <div class="container mw-narrow mw-final-inner">
        <h2 id="mw-final-title">Fragen vor der Aufnahme?</h2>
        <p class="mw-lead">Noch unsicher? Schreiben Sie uns — oder stellen Sie direkt Ihre Anfrage.</p>
        <div class="mw-actions">
          <a href={meinVereinAntragUrl} class="mw-btn mw-btn-primary" target="_blank" rel="noopener noreferrer">{ctaApply}</a>
          <a href="/kontakt" class="mw-btn mw-btn-secondary">Kontakt</a>
          <a href={ULPAN_LANDING_PATH} class="mw-btn mw-btn-outline">Ulpan Ivrit</a>
          <a href={MOODLE_INFO_PATH} class="mw-btn mw-btn-outline">Moodle</a>
        </div>
      </div>
    </section>
  </div>
</MainLayout>

<style>
  :global(.mw-main) {
    padding: 0 !important;
  }

  .mw-page {
    --mw-navy: #0c1e34;
    --mw-blue: #163b63;
    --mw-sky: #d6e1fc;
    --mw-bg: #ffffff;
    background: var(--mw-bg);
  }

  .mw-hero {
    position: relative;
    overflow: hidden;
    padding: 3rem 0 2.75rem;
    background: linear-gradient(160deg, #e8f2ff 0%, #f5f9ff 50%, #fff 100%);
  }

  .mw-hero-visual {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 60% 50% at 20% 30%, rgba(22, 59, 99, 0.1), transparent),
      radial-gradient(ellipse 50% 40% at 90% 20%, rgba(214, 225, 252, 0.9), transparent);
  }

  .mw-hero-inner {
    position: relative;
    z-index: 1;
    max-width: 720px;
  }

  .mw-eyebrow {
    margin: 0 0 0.75rem;
    font-size: 0.9rem;
    color: #475569;
  }

  .mw-hero h1 {
    margin: 0 0 0.5rem;
    font-size: clamp(2rem, 5vw, 2.85rem);
    font-weight: 800;
    color: var(--mw-navy);
    line-height: 1.1;
  }

  .mw-hero-sub {
    margin: 0 0 1rem;
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--mw-blue);
    line-height: 1.45;
  }

  .mw-price-hero {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.75rem;
    margin: 0 0 0.25rem;
  }

  .mw-price-big {
    font-size: 2.25rem;
    font-weight: 800;
    color: var(--mw-navy);
    line-height: 1;
  }

  .mw-price-unit {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--mw-blue);
  }

  .mw-price-meta {
    width: 100%;
    font-size: 0.95rem;
    color: #64748b;
  }

  .mw-page .container {
    min-width: 0;
    box-sizing: border-box;
  }

  .mw-section {
    padding: 2.75rem 0;
  }

  .mw-section-alt {
    background: #fff;
  }

  .mw-section h2 {
    margin: 0 0 1rem;
    font-size: clamp(1.5rem, 3vw, 2rem);
    color: var(--mw-navy);
  }

  .mw-lead {
    margin: 0 0 1rem;
    color: #334155;
    line-height: 1.7;
    max-width: 68ch;
  }

  .mw-narrow {
    max-width: 720px;
  }

  .mw-split {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem 3rem;
    align-items: start;
  }

  .mw-split-col h2 {
    margin-top: 0;
  }

  .mw-lead-tight {
    max-width: none;
  }

  @media (max-width: 768px) {
    .mw-split {
      grid-template-columns: 1fr;
      gap: 2.25rem;
    }
  }

  .mw-note {
    margin-top: 1.25rem;
    padding: 0.85rem 1rem;
    background: #fff;
    border: 1px solid #e2e8f0;
    border-left: 4px solid var(--mw-blue);
    border-radius: 0 8px 8px 0;
    color: #1e293b;
    line-height: 1.55;
    font-size: 0.95rem;
  }

  .mw-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  .mw-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.7rem 1.25rem;
    border-radius: 0.65rem;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    border: 2px solid transparent;
    cursor: pointer;
    transition: background 0.2s, color 0.2s, border-color 0.2s, transform 0.2s;
  }

  .mw-btn-primary {
    background: var(--mw-blue);
    color: #fff;
    border-color: var(--mw-blue);
  }

  .mw-btn-primary:hover {
    background: #0f2e50;
    transform: translateY(-1px);
  }

  .mw-btn-secondary {
    background: #fff;
    color: var(--mw-blue);
    border-color: #89a6cc;
  }

  .mw-btn-secondary:hover {
    background: var(--mw-sky);
  }

  .mw-btn-outline {
    background: transparent;
    color: #fff;
    border-color: rgba(255, 255, 255, 0.45);
  }

  .mw-btn-outline:hover {
    background: #fff;
    color: var(--mw-navy);
  }

  .mw-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
  }

  .mw-steps li {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .mw-step-num {
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--mw-blue);
    color: #fff;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.95rem;
  }

  .mw-steps h3 {
    margin: 0 0 0.35rem;
    font-size: 1.1rem;
    color: var(--mw-navy);
  }

  .mw-steps p {
    margin: 0;
    color: #475569;
    line-height: 1.6;
  }

  .mw-list {
    margin: 0;
    padding-left: 1.25rem;
    color: #334155;
    line-height: 1.75;
  }

  .mw-small {
    font-size: 0.875rem;
    color: #64748b;
  }

  .mw-form-container {
    max-width: 1280px;
  }

  .mw-form-stack {
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
  }

  .mw-form-stack .mw-lead {
    max-width: none;
  }

  .mw-form-stack h2 {
    margin-top: 0;
  }

  .mw-form-intro {
    margin-bottom: 1.5rem;
  }

  .mw-form-section {
    background: #fff;
    padding-top: 2rem;
  }

  .mw-antrag {
    padding: 1.5rem;
    background: #f8fafc;
    border: 1px solid #dbe5f1;
    border-radius: 14px;
  }

  .mw-antrag-hero {
    margin-top: 1.25rem;
    background: rgba(255, 255, 255, 0.85);
    box-shadow: 0 12px 32px rgba(12, 30, 52, 0.06);
  }

  .mw-antrag-title {
    margin: 0 0 0.75rem;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--mw-navy);
  }

  .mw-antrag-note a {
    color: var(--mw-blue);
    font-weight: 600;
  }

  .mw-antrag-text {
    margin: 0 0 1.25rem;
    color: #334155;
    line-height: 1.65;
  }

  .mw-btn-antrag {
    font-size: 1.05rem;
    padding: 0.85rem 1.6rem;
  }

  .mw-btn:focus-visible {
    outline: 3px solid var(--mw-navy);
    outline-offset: 3px;
    box-shadow: 0 0 0 5px var(--mw-sky);
  }

  .mw-antrag-note {
    margin: 0.85rem 0 0;
    font-size: 0.875rem;
    color: #64748b;
    line-height: 1.55;
  }

  @media (max-width: 768px) {
    .mw-btn-antrag {
      width: 100%;
    }
  }

  .form-note {
    margin-top: 1.25rem;
    font-size: 0.875rem;
    color: #64748b;
    line-height: 1.55;
  }

  .mw-tax-note {
    margin: 0;
  }

  .mw-tax-note h3 {
    margin: 0 0 0.5rem;
    font-size: 1.05rem;
    color: var(--mw-navy);
  }

  .mw-tax-note p {
    margin: 0 0 0.75rem;
    color: #475569;
    line-height: 1.65;
    font-size: 0.95rem;
  }

  .mw-tax-note p:last-child {
    margin-bottom: 0;
  }

  .mw-final {
    background: linear-gradient(180deg, var(--mw-navy), #0f2e50);
    color: #e2e8f0;
    padding: 3rem 0;
  }

  .mw-final h2 {
    color: #fff;
  }

  .mw-final .mw-lead {
    color: #cbd5e1;
  }

  .mw-final .mw-btn-secondary {
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
    border-color: rgba(255, 255, 255, 0.35);
  }

  @media (max-width: 768px) {
    .mw-actions .mw-btn {
      width: 100%;
    }
  }
</style>
