---
import MainLayout from '../../../layouts/MainLayout.astro';
import MembershipForm from '../../../components/MembershipForm.astro';
---

<MainLayout lang="en" title="Membership application" description="Apply for membership at BiFoDe e.V. — free of charge, reviewed by the board.">
  <section class="container" style="padding: 3rem 0">
    <h1>Membership application</h1>
    <p style="max-width: 720px; color: #475569; line-height: 1.7">
      Membership at BiFoDe e.V. is free of charge. After we receive your application, the board reviews it and you will be informed by email.
    </p>
    <MembershipForm lang="en" />
  </section>
</MainLayout>
