---
import AdminLayout from '../../components/AdminLayout.astro';
import { getDb } from '../../lib/db';
import { sessionEmail } from '../../lib/auth';

const email = sessionEmail(Astro.cookies);
if (!email) return Astro.redirect('/admin/login');

const tabs = [
  ['pending', 'Новые заявки'],
  ['active', 'Члены'],
  ['rejected', 'Отклонённые'],
  ['left', 'Вышедшие']
] as const;
const requested = Astro.url.searchParams.get('status');
const status = tabs.some(([k]) => k === requested) ? requested! : 'pending';
const title = tabs.find(([k]) => k === status)![1];
const label: Record<string, string> = { pending: 'Новая', active: 'Член', rejected: 'Отклонена', left: 'Вышел' };

type Row = { id: number; first_name: string; last_name: string; email: string; phone: string; street: string; postal_code: string; city: string; newsletter: number; locale: string; created_at: string };
const rows = getDb().prepare('SELECT * FROM members WHERE status = ? ORDER BY id DESC').all(status) as Row[];
const counts: Record<string, number> = Object.fromEntries(
  (getDb().prepare('SELECT status, COUNT(*) AS n FROM members GROUP BY status').all() as { status: string; n: number }[]).map((r) => [r.status, r.n])
);
const next: Record<string, [string, string, boolean][]> = {
  pending: [['active', 'Принять', false], ['rejected', 'Отклонить', true]],
  active: [['left', 'Отметить вышедшим', true]],
  rejected: [['pending', 'Вернуть в новые', false]],
  left: [['active', 'Снова активен', false]]
};
const fmt = (iso: string) => new Date(iso).toLocaleDateString('ru-RU', { day: '2-digit', month: '2-digit', year: 'numeric' });
---

<AdminLayout title={title} email={email} active={status} counts={counts}>
  <div class="ph">
    <div>
      <h1>{title}</h1>
      <p class="mut">Заявки на членство в BiFoDe e.V. Решение принимает правление.</p>
    </div>
    <div class="acts"><a class="btn sec" href="/admin/export.csv">Экспорт CSV</a></div>
  </div>

  <div class="kpis">
    {tabs.map(([k, name]) => (
      <a class:list={['kpi', 'click', k === 'pending' && counts.pending ? 'warn' : '', k === 'active' ? 'ok' : '']} href={`/admin?status=${k}`} style="text-decoration:none;color:inherit">
        <div class="kl">{name}</div>
        <div class="kv">{counts[k] || 0}</div>
      </a>
    ))}
  </div>

  <div class="card">
    {rows.length === 0 ? (
      <div class="empty">
        <div class="ei">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M4 12h16M4 17h10" /></svg>
        </div>
        <b>Здесь пока пусто</b>
        Записей в этом разделе нет.
      </div>
    ) : (
      <div class="tablewrap">
        <table class="tl">
          <thead><tr><th>Имя</th><th>Контакт</th><th>Адрес</th><th>Получено</th><th>Статус</th><th></th></tr></thead>
          <tbody>
            {rows.map((r) => (
              <tr>
                <td><b>{r.first_name} {r.last_name}</b><br /><span class="mut">{r.locale.toUpperCase()}{r.newsletter ? ' · рассылка' : ''}</span></td>
                <td><a href={`mailto:${r.email}`}>{r.email}</a>{r.phone ? <><br /><span class="mut">{r.phone}</span></> : null}</td>
                <td>{r.street}<br /><span class="mut">{r.postal_code} {r.city}</span></td>
                <td class="num">{fmt(r.created_at)}</td>
                <td><span class={`st ${status}`}>{label[status]}</span></td>
                <td>
                  <form method="post" action="/admin/decide" class="acts" style="justify-content:flex-end;align-items:center;margin:0">
                    <input type="hidden" name="id" value={r.id} />
                    <input type="hidden" name="back" value={status} />
                    {status === 'pending' && (
                      <label class="mut" style="display:flex;gap:4px;align-items:center;margin:0">
                        <input type="checkbox" name="notify" value="1" checked /> письмо
                      </label>
                    )}
                    {next[status].map(([to, text, danger]) => (
                      <button type="submit" name="status" value={to} class:list={['btn', 'sm', danger && 'del']}>{text}</button>
                    ))}
                  </form>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </div>
</AdminLayout>
