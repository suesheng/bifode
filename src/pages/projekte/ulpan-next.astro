---
import MainLayout from '../../layouts/MainLayout.astro';
import UlpanNextLanding from '../../components/UlpanNextLanding.astro';
import UlpanProjectTracking from '../../components/UlpanProjectTracking.astro';

const pageDescription =
  'Ulpan Ivrit ist das Bildungsprojekt von BiFoDe e.V. für modernes Hebräisch — Kurse offen für alle, ermäßigt für Vereinsmitglieder.';

const webPageJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Ulpan Ivrit – BiFoDe e.V.',
  url: 'https://www.bifode.org/projekte/ulpan-next',
  description: pageDescription,
  inLanguage: 'de-DE',
  isPartOf: { '@type': 'WebSite', name: 'BiFoDe e.V.', url: 'https://www.bifode.org/' },
});
---

<MainLayout
  title="Ulpan Ivrit"
  description={pageDescription}
  titleSuffix={false}
  mainClass="un-main"
  breadcrumbs={[
    { label: 'Startseite', href: '/' },
    { label: 'Projekte', href: '/projekte' },
    { label: 'Ulpan Ivrit' },
  ]}
>
  <UlpanProjectTracking />
  <script type="application/ld+json" set:html={webPageJsonLd} />
  <UlpanNextLanding lang="de" />
</MainLayout>

<style>
  :global(.un-main) {
    padding: 0 !important;
  }
</style>
